# 统一换行，避免 Windows 下提交 CRLF 造成全文件 diff
* text=auto eol=lf

# Windows 脚本必须保留 CRLF，否则 cmd/PowerShell 可能执行异常
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做换行转换与文本 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.mp4 binary
*.zip binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
